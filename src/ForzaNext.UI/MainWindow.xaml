<Window x:Class="ForzaNext.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForzaNext Wheel - Universal Sim-Racing Bridge" 
        Height="720" Width="1050" 
        WindowStartupLocation="CenterScreen"
        Background="#121214" Foreground="#F4F4F5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Dark Theme Styles -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#1E1E24" Margin="0,0,4,0" Padding="16,10" CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.Foreground="#A1A1AA"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2D2D35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#18181B" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="FORZANEXT WHEEL" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="v2.0 • 1000 Hz" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <Border Background="#22C55E" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                            <TextBlock Text="ODrive &amp; DIY Support" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Emulador de Volante de Corrida Universal de Baixa Latência para a Franquia Forza" FontSize="12" Foreground="#71717A" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Start/Stop Master Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleFeeder" Click="BtnToggleFeeder_Click" Width="160" Height="42" FontSize="14" Background="#10B981" Foreground="#FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtFeederBtn" Text="▶ INICIAR FEEDER" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1">
            <!-- TAB 1: MONITOR EM TEMPO REAL -->
            <TabItem Header="📊 Dashboard &amp; Monitor">
                <Border Background="#18181B" CornerRadius="0,8,8,8" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Dispositivos Detectados -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#27272A" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="DRIVER VIRTUAL" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                                    <TextBlock x:Name="TxtVirtualStatus" Text="Pronto (Integrado)" FontSize="14" FontWeight="SemiBold" Foreground="#22C55E" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#27272A" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="VOLANTE (DIRECT DRIVE)" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                                    <TextBlock x:Name="TxtWheelStatus" Text="ODrive-Wheel HID" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#27272A" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="CÂMBIO / SHIFTER" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                                    <TextBlock x:Name="TxtShifterStatus" Text="Shifter Game Controller" FontSize="14" FontWeight="SemiBold" Foreground="#EAB308" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Live Telemetry Bars -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Eixos -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="EIXOS DE ENTRADA (FEEDER ATIVO)" FontSize="13" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,0,12"/>

                                <TextBlock Text="Volante (Eixo X):" FontSize="12" Foreground="#A1A1AA"/>
                                <ProgressBar x:Name="PbSteering" Minimum="1" Maximum="32768" Value="16384" Height="22" Margin="0,4,0,12" Foreground="#38BDF8"/>

                                <TextBlock Text="Acelerador (Throttle):" FontSize="12" Foreground="#A1A1AA"/>
                                <ProgressBar x:Name="PbThrottle" Minimum="1" Maximum="32768" Value="1" Height="18" Margin="0,4,0,12" Foreground="#22C55E"/>

                                <TextBlock Text="Freio (Brake):" FontSize="12" Foreground="#A1A1AA"/>
                                <ProgressBar x:Name="PbBrake" Minimum="1" Maximum="32768" Value="1" Height="18" Margin="0,4,0,12" Foreground="#EF4444"/>

                                <TextBlock Text="Embreagem (Clutch):" FontSize="12" Foreground="#A1A1AA"/>
                                <ProgressBar x:Name="PbClutch" Minimum="1" Maximum="32768" Value="1" Height="18" Margin="0,4,0,12" Foreground="#F59E0B"/>
                            </StackPanel>

                            <!-- Marchas e Botões -->
                            <Border Grid.Column="1" Background="#27272A" CornerRadius="8" Padding="16">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="MARCHA ATUAL" FontSize="12" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center"/>
                                    <Border Background="#18181B" CornerRadius="12" Width="100" Height="100" Margin="0,10,0,16">
                                        <TextBlock x:Name="TxtCurrentGear" Text="N" FontSize="52" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="BOTÕES ATIVOS" FontSize="12" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtActiveButtons" Text="Nenhum botão pressionado" FontSize="12" Foreground="#71717A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: CONFIGURADOR & MAPEAMENTO -->
            <TabItem Header="⚙️ Mapeamento de Controles">
                <Border Background="#18181B" CornerRadius="0,8,8,8" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Configuração e Mapeamento de Hardware (Salvo em configuration.json)" FontSize="14" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Grupo de Eixos -->
                                <Border Background="#27272A" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="CALIBRAÇÃO DOS PEDAIS E VOLANTE" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Inverter Volante:" VerticalAlignment="Center" Foreground="#E4E4E7"/>
                                            <CheckBox x:Name="ChkInvertSteering" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Inverter Acelerador:" VerticalAlignment="Center" Foreground="#E4E4E7"/>
                                            <CheckBox x:Name="ChkInvertThrottle" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Inverter Freio:" VerticalAlignment="Center" Foreground="#E4E4E7"/>
                                            <CheckBox x:Name="ChkInvertBrake" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Informações do Perfil Atual -->
                                <Border Background="#27272A" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="PERFIL ATUAL DETECTADO" FontSize="12" FontWeight="Bold" Foreground="#22C55E" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Volante: ODrive-Wheel HID (Eixos 0: Steering, 3: Clutch, 4: Brake, 5: Throttle)" FontSize="12" Foreground="#A1A1AA"/>
                                        <TextBlock Text="• Câmbio: Shifter Game Controller (Botões 0, 1, 2 mapeados para Marchas)" FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Botão Salvar -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button x:Name="BtnReloadConfig" Click="BtnReloadConfig_Click" Content="Recarregar do Disco" Width="160" Background="#3F3F46" Margin="0,0,10,0"/>
                            <Button x:Name="BtnSaveConfig" Click="BtnSaveConfig_Click" Content="Salvar Configuração" Width="160" Background="#0284C7"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: FORCE FEEDBACK -->
            <TabItem Header="⚡ Force Feedback (FFB)">
                <Border Background="#18181B" CornerRadius="0,8,8,8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Ajustes de Force Feedback para Motores Direct Drive" FontSize="14" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,0,16"/>

                        <Border Background="#27272A" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="FORÇA DE CREMALHEIRA (RACK / CONSTANT FORCE)" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                                <TextBlock Text="Multiplicador geral de força enviado do jogo diretamente para o ODrive:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                                <Slider x:Name="SlConstantForce" Minimum="0.1" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#27272A" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="AMORTECIMENTO DINÂMICO (DAMPER)" FontSize="12" FontWeight="Bold" Foreground="#22C55E" Margin="0,0,0,6"/>
                                <TextBlock Text="Simula o peso e inércia do pneu em contato com o asfalto:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                                <Slider x:Name="SlDamper" Minimum="0.0" Maximum="1.0" Value="0.15" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#27272A" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="MOLA DE CENTRALIZAÇÃO (SPRING)" FontSize="12" FontWeight="Bold" Foreground="#EAB308" Margin="0,0,0,6"/>
                                <TextBlock Text="Força de retorno ao centro quando parado ou em baixa velocidade:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                                <Slider x:Name="SlSpring" Minimum="0.0" Maximum="1.0" Value="0.15" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 4: COMPATIBILIDADE FORZA -->
            <TabItem Header="🏎️ Suporte à Franquia Forza">
                <Border Background="#18181B" CornerRadius="0,8,8,8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Compatibilidade com Jogos da Franquia Forza" FontSize="14" FontWeight="Bold" Foreground="#E4E4E7" Margin="0,0,0,12"/>
                        <TextBlock Text="O ForzaNextWheel utiliza o protocolo canônico VID: 1234 e PID: BEAD para ser reconhecido instantaneamente como volante oficial em todos os jogos abaixo:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,16"/>

                        <Border Background="#27272A" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                            <TextBlock Text="✔ Forza Horizon 5 (Steam &amp; Microsoft Store / Game Pass)&#x0a;✔ Forza Horizon 4 (Steam &amp; Microsoft Store)&#x0a;✔ Forza Horizon 3&#x0a;✔ Forza Motorsport (2023)&#x0a;✔ Forza Motorsport 7" FontSize="13" LineHeight="24" Foreground="#E4E4E7"/>
                        </Border>

                        <TextBlock Text="Dica de Execução:" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" Margin="0,10,0,4"/>
                        <TextBlock Text="1. Conecte o ODrive e o Shifter na porta USB.&#x0a;2. Clique em 'INICIAR FEEDER' no topo desta janela.&#x0a;3. Abra o seu jogo Forza e vá em Configurações > Controles > Volante." FontSize="12" Foreground="#A1A1AA" LineHeight="20"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Footer -->
        <Border Grid.Row="2" Background="#18181B" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <TextBlock x:Name="TxtConsole" Text="ForzaNextWheel pronto para iniciar." FontSize="12" Foreground="#71717A"/>
        </Border>
    </Grid>
</Window>
